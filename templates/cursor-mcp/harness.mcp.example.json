{
  "mcpServers": {
    "harness": {
      "command": "node",
      "args": [
        "--import",
        "tsx",
        "@AGENT_HARNESS_HOME@/runtime/mcp/harness-mcp-server/src/server.ts"
      ],
      "env": {
        "AGENT_HARNESS_HOME": "@AGENT_HARNESS_HOME@",
        "AEGIS_WORKSPACE": "@AEGIS_RPC_ROOT@",
        "AEGIS_RPC_ROOT": "@AEGIS_RPC_ROOT@"
      }
    },
    "real-hermes": {
      "command": "node",
      "args": [
        "--import",
        "tsx",
        "@AGENT_HARNESS_HOME@/tools/real-hermes-mcp/src/server.ts"
      ],
      "env": {
        "AEGIS_WORKSPACE": "@AGENT_HARNESS_HOME@",
        "AEGIS_RPC_ROOT": "@AEGIS_RPC_ROOT@"
      }
    }
  }
}
