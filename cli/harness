#!/usr/bin/env bash
# Harness CLI entrypoint
set -euo pipefail
HARNESS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export AGENT_HARNESS_HOME="${AGENT_HARNESS_HOME:-$HARNESS_ROOT}"
CMD="${1:-}"
shift || true
case "$CMD" in
  doctor)         exec "$HARNESS_ROOT/cli/commands/doctor.sh" "$@" ;;
  sync-cursor)    exec "$HARNESS_ROOT/cli/commands/sync-cursor.sh" "$@" ;;
  projects)       exec python3 "$HARNESS_ROOT/scripts/project-registry.py" "$@" ;;
  approval)       exec "$HARNESS_ROOT/cli/commands/approval.sh" "$@" ;;
  runtime)        exec "$HARNESS_ROOT/cli/commands/runtime.sh" "$@" ;;
  task)           exec "$HARNESS_ROOT/cli/commands/task.sh" "$@" ;;
  state)          exec "$HARNESS_ROOT/cli/commands/state.sh" "$@" ;;
  worker)         exec "$HARNESS_ROOT/cli/commands/worker.sh" "$@" ;;
  switch-project) exec "$HARNESS_ROOT/cli/commands/switch-project.sh" "$@" ;;
  start-mcp)
    PROJECT_ID="${1:-${HARNESS_PROJECT_ID:-}}"
    [ -n "$PROJECT_ID" ] || { echo "start-mcp: registered project ID or slug required" >&2; exit 2; }
    export HARNESS_PROJECT_ID="$PROJECT_ID"
    exec node --import tsx "$HARNESS_ROOT/runtime/mcp/harness-mcp-server/src/entrypoints/cursor.ts"
    ;;
  start-hermes-mcp)
    exec node --import tsx "$HARNESS_ROOT/runtime/mcp/harness-mcp-server/src/entrypoints/hermes-operator.ts"
    ;;
  status|smoke|sync-skills|sync-hermes|sync-kanban|new-task|verify-task|\
  init-project|link-project|index-project|run-task|run-report|start-a2a|\
  obsidian|start-hermes-doctor|audit|cursor-fleet)
    echo "$CMD: disabled legacy command; no Agent Harness v1 activation gate exists" >&2
    exit 2
    ;;
  *)
    echo "Usage: harness {doctor|projects|approval|runtime|task|state|worker|sync-cursor|start-mcp|start-hermes-mcp} [args]"
    exit 1
    ;;
esac
