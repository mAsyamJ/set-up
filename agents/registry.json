{
  "schema": "agent-harness.agents.v1",
  "agents": {
    "orchestrator": {
      "file": "orchestrator.agent.md",
      "mode": "supervisor",
      "allowed_tools": ["harness.project.inspect", "harness.task.move", "harness.verify.run"],
      "forbidden_tools": ["shell.run", "repo.apply_patch"],
      "handoffs": ["architect", "implementer", "qa", "security"]
    },
    "architect": {
      "file": "architect.agent.md",
      "mode": "plan",
      "allowed_tools": ["repo.read", "repo.search", "harness.rag.search"],
      "handoffs": ["implementer"]
    },
    "implementer": {
      "file": "backend.agent.md",
      "mode": "implement",
      "allowed_tools": ["repo.read", "repo.search", "git.status", "git.diff", "task.move"],
      "handoffs": ["qa", "security"]
    },
    "security": {
      "file": "security.agent.md",
      "mode": "review",
      "allowed_tools": ["repo.read", "repo.search", "git.diff"],
      "forbidden_tools": ["shell.run", "repo.apply_patch"],
      "handoffs": ["qa"]
    },
    "qa": {
      "file": "qa.agent.md",
      "mode": "verify",
      "allowed_tools": ["harness.verify.run", "git.status"],
      "handoffs": ["docs"]
    },
    "docs": {
      "file": "docs.agent.md",
      "mode": "document",
      "allowed_tools": ["repo.read", "task.move"],
      "handoffs": []
    },
    "reviewer": {
      "file": "reviewer.agent.md",
      "mode": "review",
      "allowed_tools": ["repo.read", "git.diff"],
      "handoffs": ["orchestrator"]
    }
  },
  "parallel_review": {
    "trigger": "task.review",
    "agents": ["security", "qa", "reviewer"],
    "kanban_profiles": ["aegis-security", "aegis-qa"]
  }
}
