{
  "include": [
    "apps/**",
    "crates/**",
    "config/**",
    "scripts/**",
    "docs/**",
    ".harness/project-context.md",
    ".harness/agents/**",
    "AGENTS.md",
    "ORCHESTRATOR.md",
    "DECISIONS.md"
  ],
  "exclude": [
    "**/target/**",
