{
  "include": [
    "apps/**",
    "packages/**",
    "contracts/**",
    "docs/**",
    ".harness/project-context.md",
    "AGENTS.md",
    "ORCHESTRATOR.md",
    "DECISIONS.md"
  ],
  "exclude": [
