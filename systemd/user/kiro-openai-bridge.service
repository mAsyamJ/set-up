[Unit]
Description=Kiro OpenAI-Compatible Bridge for Hermes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/asyam/dev/Project/aegis-hackathon-kit/tools/kiro-openai-bridge
Environment=AEGIS_WORKSPACE=/home/asyam/dev/Project/aegis-hackathon-kit
Environment=AEGIS_REPO_PATH=/home/asyam/dev/Project/aegis-hackathon-kit
Environment=PORT=8787
Environment=PATH=/home/asyam/.nvm/versions/node/v22.22.2/bin:/home/asyam/.local/bin:/home/asyam/.cargo/bin:/mnt/d/Kiro/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/asyam/.nvm/versions/node/v22.22.2/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=aegis-stack.target
