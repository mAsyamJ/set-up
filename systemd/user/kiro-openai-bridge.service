[Unit]
Description=Kiro OpenAI-Compatible Bridge for Hermes (127.0.0.1 only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@AGENT_HARNESS_HOME@/tools/kiro-openai-bridge
Environment=AGENT_HARNESS_HOME=@AGENT_HARNESS_HOME@
Environment=AEGIS_WORKSPACE=@AEGIS_RPC_ROOT@
Environment=AEGIS_REPO_PATH=@AGENT_HARNESS_HOME@
Environment=AEGIS_MODEL_STATE=@AGENT_HARNESS_HOME@/runtime/aegis-model.json
Environment=PATH=@AEGIS_NODE_DIR@:/home/asyam/.local/bin:/usr/bin:/bin
ExecStart=@AEGIS_NODE@ server.js
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
