[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/asyam/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run --replace
WorkingDirectory=/home/asyam/.hermes/hermes-agent
Environment="PATH=/home/asyam/.hermes/hermes-agent/venv/bin:/home/asyam/.hermes/hermes-agent/node_modules/.bin:/home/asyam/.nvm/versions/node/v22.22.2/bin:/home/asyam/.local/bin:/home/asyam/.cargo/bin:/home/asyam/go/bin:/mnt/c/Windows/system32:/mnt/c/Windows:/mnt/c/Windows/System32/Wbem:/mnt/c/Windows/System32/WindowsPowerShell/v1.0/:/mnt/c/Windows/System32/OpenSSH/:/mnt/c/Users/LENOVO/AppData/Local/Programs/Python/Python313:/mnt/c/Users/LENOVO/AppData/Local/Programs/Python/Python313/Scripts:/mnt/c/Program Files/usbipd-win/:/mnt/c/Program Files/Git/cmd:/mnt/c/Program Files/nodejs/:/mnt/c/Users/LENOVO/AppData/Local/Programs/Python/Launcher/:/mnt/c/Users/LENOVO/.cargo/bin:/mnt/c/Users/LENOVO/AppData/Local/Microsoft/WindowsApps:/mnt/c/Users/LENOVO/AppData/Local/Programs/Microsoft VS Code/bin:/mnt/c/Users/LENOVO/AppData/Local/Programs/Ollama:/mnt/d/Program Files/cursor/resources/app/bin:/mnt/c/Users/LENOVO/AppData/Roaming/npm:/mnt/c/Users/LENOVO/.foundry/bin:/mnt/e/:/mnt/d/Kiro/bin:/mnt/c/Windows/System32:/mnt/c/Windows/System32/WindowsPowerShell/v1.0:/mnt/c/WINDOWS/system32:/mnt/c/WINDOWS:/mnt/c/WINDOWS/System32/Wbem:/mnt/c/WINDOWS/System32/WindowsPowerShell/v1.0/:/mnt/c/WINDOWS/System32/OpenSSH/:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/asyam/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/asyam/.hermes"
Restart=always
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
