{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "resolveJsonModule": true
  },
  "include": [
    "core/**/*.ts",
    "rag/**/*.ts",
    "integrations/**/*.ts",
    "cli/**/*.ts",
    "tools/gateway/**/*.ts",
    "runtime/mcp/harness-mcp-server/src/**/*.ts",
    "runtime/a2a/harness-a2a-server/src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "projects"]
}
