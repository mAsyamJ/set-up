# Optional: copy values to ~/.hermes/.env (loaded by kiro-openai-bridge.service)
#
# OpenAI Codex backend
# Interactive Hermes bridge: run `codex login` once (ChatGPT login).
# Background audit automation: direct Responses API still requires:
# OPENAI_API_KEY=sk-...
# OPENAI_CODEX_MODEL_INTERACTIVE=gpt-5.1-codex
# OPENAI_CODEX_MODEL_AUDIT=gpt-5.1-codex-max
# OPENAI_CODEX_REASONING_EFFORT=medium
# AEGIS_AUDIT_RESUME_INTERVAL_SEC=300
# AEGIS_AUDIT_STATUS_CRON=0 * * * *
# AEGIS_AUDIT_RETRY_MAX_DELAY_SEC=21600
#
# Cursor backend for Hermes bridge (when /provider cursor or aegis-model.sh cursor)
# Option A (recommended): run `agent login` once — no key needed (uses OAuth session)
# Option B: API key from https://cursor.com/dashboard (Integrations)
# CURSOR_API_KEY=cursor_...

# Optional Cursor model id (default: composer-2)
# CURSOR_MODEL=composer-2

# Cursor bridge execution mode (default: agent = edits + shell; ask/plan = read-only)
# CURSOR_BRIDGE_MODE=agent

# Optional: force allow commands in agent CLI mode (default: on when mode=agent)
# CURSOR_AGENT_FORCE=1

# Optional initial default when runtime/aegis-model.json is missing (default: kiro-current)
# AEGIS_DEFAULT_MODEL=kiro-current

# Telegram (Hermes gateway — required for 24/7 bot)
# TELEGRAM_BOT_TOKEN=...
# WSL: TELEGRAM_FALLBACK_IPS=149.154.167.220,149.154.167.221
# HERMES_TELEGRAM_HTTP_CONNECT_TIMEOUT=45
# HERMES_TELEGRAM_HTTP_READ_TIMEOUT=90

# Headless maintenance remains disabled until the worker rollout gate:
#   scripts/aegis-secrets-health.sh
#   scripts/aegis-secrets-maintain.sh
# Optional harness paths (defaults resolve from repo layout)
# AGENT_HARNESS_HOME=/absolute/path/to/agent-harness
# AEGIS_RPC_ROOT=/absolute/path/to/external-project
# AEGIS_WORKSPACE=/absolute/path/to/external-project

# Legacy Cursor fleet settings are intentionally unsupported. The v1 rollout
# permits one lease-bound disposable canary only; there is no fleet enable flag.
